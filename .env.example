# Public URL of the app (used for Stripe redirects and checkout success/cancel URLs)
APP_URL=http://localhost:3000

# Optional: Stripe live/test integration (omit to use built-in simulated checkout)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: PostgreSQL when wiring Prisma (schema included; server uses in-memory store by default)
DATABASE_URL=postgresql://user:password@localhost:5432/saas_dashboard

# Optional: NextAuth (auth.ts is prepared for a Next.js migration; Express uses custom session APIs)
NEXTAUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
